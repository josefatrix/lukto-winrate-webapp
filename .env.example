# Firebase Configuration
# Copy this file to .env.local and fill in your values

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Configuration
VITE_ADMIN_PASSWORD=your-secure-password
VITE_SUPER_ADMIN_EMAIL=your-email@gmail.com
ah

# ── Asistente de IA (SOLO servidor) ──────────────────────────────────────────
# Estas dos NO van en .env.local ni llevan prefijo VITE_: ese prefijo es lo que
# hace que Vite las incruste en el bundle del navegador, donde cualquiera las
# puede leer. Van en las variables de entorno del proyecto en Vercel
# (vercel env add, o Settings > Environment Variables).
#
# ANTHROPIC_API_KEY=sk-ant-...
#   La key de console.anthropic.com. La usa api/assistant.js.
#
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#   El JSON completo de una cuenta de servicio del proyecto lukto-tracker, en
#   una sola línea. firebase-admin la necesita para verificar los ID tokens y
#   para escribir el contador de aiUsage.
